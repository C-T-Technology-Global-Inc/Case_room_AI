# Online demo settings. Copy to deploy/.env on the server and fill in.
# Never commit deploy/.env. Step by step: docs/DEPLOY_DEMO.md.

# The demo's address. Its DNS A record must point to this server.
DEMO_DOMAIN="demo.example.com"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Supabase: Connect > Session pooler (port 5432), with the password filled in,
# then this ending added: encrypted, and checked against Supabase's certificate
# saved as deploy/certs/supabase-ca.crt.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/certs/supabase-ca.crt"

# Shared password for the whole site (asked by the browser before the app's sign-in).
# Hash: docker run --rm caddy:2 caddy hash-password --plaintext 'your-demo-password'
# Keep the hash in SINGLE quotes: Docker Compose would read each $ in it as a variable otherwise.
DEMO_USER="demo"
DEMO_PASSWORD_HASH='$2a$14$replace.with.the.hash.from.caddy.hash-password.command'

# Optional: live AI (Claude) instead of the offline demo engine. Everyone with the
# site password can then spend on this key: set a monthly spending limit in the
# Anthropic console first. Daily caps are in docker-compose.yml (override them here).
AI_PROVIDER="demo"
ANTHROPIC_API_KEY=""

# AGPL-3.0: users of a modified version must be offered its source code.
SOURCE_CODE_URL="https://github.com/C-T-Technology-Global-Inc/Case_room_AI"

# Optional: email (password reset, invitations). Without it, share invitation links by hand.
EMAIL_TRANSPORT="none"
SMTP_URL=""
EMAIL_FROM=""
