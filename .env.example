# ─────────────────────────────────────────────────────────────
# Clinical Case Room: environment configuration
# Copy to `.env` in the repository root. Both the web app and
# the database package read this single file.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinical_case_room"

# Separate database for `npm run test:integration` (its name must end in _test;
# the tests erase it). Create it with: createdb clinical_case_room_test
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinical_case_room_test"

# Separate database for `npm run test:e2e` (name must end in _e2e; erased and
# re-seeded on every run). Create it with: createdb clinical_case_room_e2e
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinical_case_room_e2e"

# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public URL of the app (used by Auth.js and invitation links)
APP_URL="http://localhost:3000"
# Repository of the code this deployment runs. The AGPL-3.0 license requires
# offering it to users of a modified version; the app links to it on every screen.
SOURCE_CODE_URL=""

# ── AI provider ──────────────────────────────────────────────
# One of: anthropic | openai | demo
# If unset, the app picks anthropic when ANTHROPIC_API_KEY is present,
# then openai when OPENAI_API_KEY is present, otherwise the offline demo engine.
AI_PROVIDER=""

ANTHROPIC_API_KEY=""
# Optional overrides
ANTHROPIC_MODEL="claude-opus-5-5"
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT="medium"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

# ── Abuse limits ─────────────────────────────────────────────
# AI calls use the deployment's provider key for every organization.
# Budget is reserved before every model call and failed calls still count.
# 0 disables a limit.
AI_REQUESTS_PER_USER_PER_MINUTE="12"
# Model calls per organization, rolling 24 h (a document upload uses 2)
AI_DAILY_REQUESTS_PER_ORG="500"
# AI jobs running at the same time per organization
AI_CONCURRENT_RUNS_PER_ORG="4"
# Model calls for the whole deployment, rolling 24 h (0 = no deployment cap)
AI_DAILY_REQUESTS_TOTAL="0"
# Failed sign-ins per 15 minutes: per email from one client address, per
# address across emails, and per email across all addresses (the last one does
# not apply to browsers where the account signed in before: device cookie)
SIGNIN_ATTEMPTS_PER_EMAIL="10"
SIGNIN_ATTEMPTS_PER_IP="50"
SIGNIN_ATTEMPTS_PER_ACCOUNT="100"
# Uploads read and text-extracted at the same time, per app process
MAX_CONCURRENT_UPLOADS="4"
# Account creation per client IP per hour
SIGNUPS_PER_IP_PER_HOUR="5"
INVITE_ACCEPTS_PER_IP_PER_HOUR="10"
# Set to "false" on any deployment others can reach: hides the demo accounts
# on the sign-in page (and never seed such a deployment: demo password is public)
DEMO_LOGIN="true"
# Set to "false" to stop self-service creation of organizations (signup and
# "Create organization"); people then join only through invitations
PUBLIC_SIGNUP="true"
# Maximum organizations one account can belong to (caps creating organizations
# to multiply the per-organization AI quota)
MAX_ORGANIZATIONS_PER_ACCOUNT="10"
# Per-IP limits rely on a trusted reverse proxy that overwrites
# X-Forwarded-For. Burst, sign-in and upload counters are kept in process
# memory; with several app instances add a shared limiter at the gateway.
# AI budgets and the membership cap are enforced in the database.

# ── Object storage for uploaded documents ────────────────────
# Leave S3_BUCKET empty to store files on local disk: STORAGE_DIR, or
# ./apps/web/.storage when unset (/data/storage in the container image).
STORAGE_DIR=""
S3_BUCKET=""
S3_REGION="us-east-1"
# Set for S3-compatible providers such as MinIO or Cloudflare R2
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# AES256 (default), aws:kms, or "" for S3-compatible services that reject the header
S3_SERVER_SIDE_ENCRYPTION="AES256"
